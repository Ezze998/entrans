# Local Laravel API
# Keep the /api suffix out of this value; the API helper adds it automatically.
VITE_API_BASE_URL=http://127.0.0.1:8000

# For Vercel production, set VITE_API_BASE_URL in Project Settings > Environment Variables
# to your active Ngrok HTTPS URL, for example:
# VITE_API_BASE_URL=https://your-tunnel.ngrok-free.app
